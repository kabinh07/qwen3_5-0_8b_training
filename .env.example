# ── Required ──────────────────────────────────────────────────────────────────
HF_TOKEN=
# ── Dataset ───────────────────────────────────────────────────────────────────
HF_DATASET=kavinh07/ocr_dataset_shamadhan_synth_30k_p5
DATA_DIR=/workspace/data
OUTPUT_DIR=/workspace/outputs
MODEL_SAVE_DIR=/workspace/outputs/qwen_lora
# ── Model ─────────────────────────────────────────────────────────────────────
BASE_MODEL=unsloth/Qwen3.5-0.8B
LOAD_IN_4BIT=false
# ── LoRA ──────────────────────────────────────────────────────────────────────
LORA_R=16
LORA_ALPHA=16
LORA_DROPOUT=0.05
FINETUNE_VISION_LAYERS=false       # frozen: preserve pre-trained glyph features
FINETUNE_LANGUAGE_LAYERS=true
FINETUNE_ATTENTION_MODULES=true
FINETUNE_MLP_MODULES=true
# ── Training hyperparams ──────────────────────────────────────────────────────
TRAIN_SAMPLES=0                    # 0 = use full train split (after oversampling)
VAL_SAMPLES=5000
PER_DEVICE_BATCH_SIZE=16
PER_DEVICE_EVAL_BATCH_SIZE=16
GRADIENT_ACCUMULATION_STEPS=4     # effective batch = 64
WARMUP_RATIO=0.05                  # replaces WARMUP_STEPS — 5% of total steps
MAX_STEPS=-1                       # -1 uses NUM_TRAIN_EPOCHS
NUM_TRAIN_EPOCHS=5                 # was 1 — conjuncts need repetition
EARLY_STOPPING_PATIENCE=3         # stops if val CER doesn't improve for 3 evals
LEARNING_RATE=2e-4
WEIGHT_DECAY=0.01                  # was 0.001 — helps generalisation
LR_SCHEDULER=cosine                # was linear — smoother decay for rare tokens
SEED=3407
# ── Logging / eval ────────────────────────────────────────────────────────────
LOGGING_STEPS=50                   # more frequent loss visibility
EVAL_STEPS=500                     # eval every 500 steps to catch overfitting early
DATASET_NUM_PROC=4
# ── Oversampling ─────────────────────────────────────────────────────────────
CONFUSION_OVERSAMPLE=4             # repeat confusion_training rows N times
# ── Hub push ─────────────────────────────────────────────────────────────────
PUSH_TO_HUB=true
HF_REPO_ID=kavinh07/unsloth_finetune_qwen3.5-0.8B_p5
# ── Export ────────────────────────────────────────────────────────────────────
SAVE_MERGED_16BIT=true
SAVE_GGUF_Q8=true
SAVE_GGUF_Q4_K_M=true
# ── Prompt ────────────────────────────────────────────────────────────────────
OCR_PROMPT=All text in this image is in {LANG}. Transcribe every character exactly as it appears, including all conjunct consonants. Output only the transcribed text, nothing else.
# ── Inference (mode=infer only) ───────────────────────────────────────────────
INFER_IMAGE_DIR=/workspace/qwen3_5-0_8b_training/test
INFER_MODEL_PATH=/workspace/outputs/qwen_lora
